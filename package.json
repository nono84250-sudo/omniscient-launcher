{
  "name": "launcher",
  "productName": "Omniscient Launcher",
  "version": "0.4.8",
  "private": true,
  "description": "Launcher Minecraft Omniscient — lit les serveurs publiés sur le site Omniscient et lance le jeu.",
  "author": "Rushifa",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/nono84250-sudo/omniscient-launcher.git"
  },
  "main": "src/main.js",
  "homepage": "https://omniscientlauncher.com",
  "desktopName": "omniscient-launcher.desktop",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/generate-env.js",
    "dist": "electron-builder",
    "predist:linux": "node scripts/generate-env.js",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.11.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@sentry/electron": "7.20.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "app.omniscient.launcher",
    "productName": "Omniscient Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "omnipack",
        "name": "Pack Omniscient",
        "description": "Pack Omniscient",
        "icon": "build/icon.ico"
      }
    ],
    "protocols": [
      {
        "name": "Omniscient Launcher",
        "schemes": [
          "omniscient"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "nono84250-sudo",
      "repo": "omniscient-launcher"
    },
    "win": {
      "target": "nsis-web",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "omniscient-launcher",
      "syncDesktopName": true,
      "maintainer": "Omniscient",
      "synopsis": "Launcher Minecraft Omniscient",
      "artifactName": "OmniscientLauncher.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "deb": {
      "packageName": "omniscient-launcher",
      "artifactName": "omniscient-launcher_amd64.${ext}"
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OmniscientLauncherSetup.${ext}"
    }
  }
}
